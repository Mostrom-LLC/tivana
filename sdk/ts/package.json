{
  "name": "@mostrom/tivana",
  "version": "0.1.0",
  "description": "TypeScript SDK for Tivana - Streaming browser perception protocol for AI agents",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "bin": {
    "tivana": "bin/tivana.mjs"
  },
  "files": [
    "dist",
    "bin",
    "extension"
  ],
  "scripts": {
    "build": "bun build src/index.ts --outdir dist --target node --format cjs && cp dist/index.js dist/index.cjs && bun build src/index.ts --outdir dist --target node --format esm && mv dist/index.js dist/index.mjs && mv dist/index.cjs dist/index.js && tsc --emitDeclarationOnly",
    "dev": "bun --watch src/index.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "smoke-test": "bun run smoke-test.ts",
    "example": "bun run examples/smoke-test.ts",
    "prepack": "rm -rf extension && cp -r ../../extension extension",
    "prepublishOnly": "npm run build && npm run typecheck"
  },
  "keywords": [
    "browser",
    "automation",
    "ai",
    "agent",
    "perception",
    "cdp",
    "chromium"
  ],
  "author": "Mostrom LLC",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Mostrom-LLC/tivana.git"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^25.5.0",
    "@types/ws": "^8.18.1",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "ws": "^8.0.0"
  },
  "optionalDependencies": {
    "bufferutil": "^4.0.0",
    "utf-8-validate": "^6.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
